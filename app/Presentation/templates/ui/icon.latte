<svg class="ui-icon flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{switch $name}
{case 'mail'}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/>
{case 'edit'}<path d="m16 3 5 5M4 20l5-1L21 7a2.1 2.1 0 0 0-5-5L4 14Z"/>
{case 'download'}<path d="M12 3v12m-5-5 5 5 5-5M4 16v4h16v-4"/>
{case 'copy'}<rect x="8" y="8" width="12" height="13" rx="2"/><path d="M15 8V3H3v13h5"/>
{case 'trash'}<path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7"/>
{case 'save'}<path d="M20 21H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h13l4 4v13a1 1 0 0 1-1 1ZM7 3v6h9V3M7 21v-7h10v7"/>
{case 'check'}<path d="m5 12 4 4L19 6"/>
{case 'close'}<path d="m6 6 12 12M6 18 18 6"/>
{case 'more'}<circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/>
{/switch}
</svg>
