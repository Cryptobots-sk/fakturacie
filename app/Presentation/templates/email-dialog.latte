<dialog id="email-dialog" class="app-dialog app-dialog--wide border-0 rounded-3 p-3 p-md-4" aria-labelledby="email-dialog-title">
<div class="d-flex justify-content-between align-items-center gap-3 mb-3"><div><h2 id="email-dialog-title" class="h4 mb-1">Poslať faktúru e-mailom</h2><p class="small text-secondary mb-0" id="email-from"></p></div><button type="button" class="btn btn-light btn-sm" data-close-dialog>Zavrieť</button></div>
<p id="email-config-hint" class="alert alert-warning" hidden>Najprv nastav SMTP server v <a n:href="Settings:default" class="alert-link">Moja firma</a>.</p>
<form id="email-form">
<div class="row g-3"><div class="col-md-5"><label for="email-to" class="form-label">Príjemca *</label><input type="email" id="email-to" name="to" class="form-control" maxlength="160" required autocomplete="email"></div><div class="col-md-7"><label for="email-subject" class="form-label">Predmet *</label><input id="email-subject" name="subject" class="form-control" maxlength="180" required></div><div class="col-12"><label for="email-message" class="form-label">Správa *</label><textarea id="email-message" name="message" class="form-control" rows="5" maxlength="4000" required></textarea></div></div>
<p class="small text-secondary mt-3 mb-2">Príloha: <strong id="email-attachment"></strong></p>
<section class="border rounded-3 p-3 mt-3" aria-labelledby="email-preview-title"><h3 id="email-preview-title" class="h6 mb-3">Náhľad obsahu e-mailu</h3><p id="email-message-preview" class="email-preview__message"></p><div class="bg-light border rounded-3 p-3"><p class="mb-1">Faktúra <strong id="email-number"></strong> · <span id="email-customer"></span></p><p class="fs-4 text-primary fw-semibold mb-2" id="email-amount"></p><p class="mb-0">Splatnosť: <strong id="email-dueDate"></strong><br>IBAN: <strong id="email-iban" class="text-break"></strong><br>BIC / SWIFT: <span id="email-bic"></span><br>Variabilný symbol: <strong id="email-reference"></strong></p></div><div id="email-qrs" class="row g-3 mt-1"></div><p class="small text-secondary mt-2 mb-0">Tieto údaje a QR kódy sa vložia do tela správy. PDF faktúra bude priamo v prílohe.</p></section>
<p id="email-error" class="text-danger mt-3" role="alert" hidden></p><p id="email-status" class="mt-3" role="status" hidden></p><div class="d-flex justify-content-end mt-4"><button type="submit" id="email-send" class="btn btn-primary">Odoslať e-mail</button></div>
</form></dialog>
