{block content}
<div class="d-flex align-items-start justify-content-between gap-3 mb-4"><div><h1 class="display-6 fw-semibold mb-2">Faktúry</h1><p class="text-secondary mb-0">Od prvého riadku po hotové PDF.</p></div><a n:href="Invoice:default" class="btn btn-primary mt-2">+ Nová faktúra</a></div>
<section aria-label="Zoznam faktúr" class="workspace bg-white rounded-3 border">
<div class="p-3 p-md-4 border-bottom d-flex gap-3 flex-wrap justify-content-between align-items-center"><div role="group" aria-label="Stav faktúry" class="d-flex gap-1"><button class="btn btn-sm btn-primary" data-filter="all" aria-pressed="true">Všetky <span class="ms-1">{count($invoices)}</span></button><button class="btn btn-sm btn-light" data-filter="draft" aria-pressed="false">Koncepty</button><button class="btn btn-sm btn-light" data-filter="issued" aria-pressed="false">Vystavené</button></div><div class="search-field"><label class="visually-hidden" for="invoice-search">Hľadať faktúru alebo zákazníka</label><input id="invoice-search" type="search" class="form-control" placeholder="Číslo alebo zákazník…"></div></div>
<div class="invoice-list">
<div class="row g-3 px-4 py-3 small text-secondary border-bottom d-none d-md-flex"><div class="col-5">FAKTÚRA / ODBERATEĽ</div><div class="col-2">VYSTAVENIE</div><div class="col-2">STAV</div><div class="col-3 text-end">CELKOM</div></div>
{foreach $invoices as $document}
<a n:href="Invoice:default $document['id']" class="invoice-list__row d-block text-decoration-none text-body px-3 px-md-4 py-4 border-bottom" data-invoice-row data-status="{$document['status']}" data-search="{$document['number']} {$document['customer']['name'] ?? ''}">
<div class="row g-3 align-items-center"><div class="col-8 col-md-5"><span class="fw-semibold d-block">{$document['number'] ?: 'Rozpracovaná faktúra'}</span><span class="text-secondary small">{$document['customer']['name'] ?? 'Odberateľ ešte nie je vybraný'}</span></div><div class="col-md-2 d-none d-md-block small text-secondary">{if $document['issueDate']}{$document['issueDate']|date:'d.m.Y'}{else}—{/if}</div><div class="col-4 col-md-2 text-end text-md-start"><span class="badge rounded-pill {if $document['status'] === 'issued'}text-bg-issued{else}text-bg-draft{/if}">{$document['status'] === 'issued' ? 'Vystavená' : 'Koncept'}</span></div><div class="col-12 col-md-3 text-md-end fw-semibold tabular">{$document['totals']['gross']|money}<span class="ms-3 text-secondary" aria-hidden="true">↗</span></div></div></a>
{/foreach}
<p id="list-empty" class="text-secondary text-center p-5 mb-0" hidden>Žiadna faktúra nezodpovedá vyhľadávaniu.</p>
</div></section>
<p class="small text-secondary mt-3">Vystavením sa pridelí číslo a uloží PDF. Každú faktúru môžeš upraviť alebo vymazať.</p>
{/block}
