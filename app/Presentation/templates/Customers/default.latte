{block content}
<div class="d-flex align-items-start justify-content-between gap-3 mb-4"><div><h1 class="display-6 fw-semibold mb-2">Zákazníci</h1><p class="text-secondary">Údaje vyplníš raz. Na faktúre už len vyberieš firmu.</p></div><button class="btn btn-primary mt-2" id="add-customer">+ Nový zákazník</button></div>
<section class="bg-white rounded-3 border" aria-label="Adresár zákazníkov">
<div class="p-3 p-md-4 border-bottom d-flex justify-content-between align-items-center gap-3 flex-wrap"><div class="d-flex gap-3"><a n:href="default" class="{if !$archived}fw-semibold{/if}">Aktívni</a><a n:href="default archived: true" class="{if $archived}fw-semibold{/if}">Archivovaní</a></div><div class="search-field"><label for="customer-search" class="visually-hidden">Hľadať zákazníka</label><input id="customer-search" type="search" class="form-control" placeholder="Názov firmy alebo IČO…"></div></div>
{foreach $customers as $customer}<article class="p-3 p-md-4 border-bottom" data-customer-row data-search="{$customer['name']} {$customer['ico']} {$customer['city']}"><div class="d-flex justify-content-between align-items-start gap-3 flex-wrap"><div><h2 class="h5 mb-2">{$customer['name']}</h2><p class="mb-1 text-secondary">{$customer['street']}, {$customer['zip']} {$customer['city']}</p><p class="small text-secondary mb-0">IČO {$customer['ico'] ?: '—'}<span class="mx-2">·</span>{$customer['email'] ?: 'E-mail nie je vyplnený'}</p></div><div class="d-flex gap-2"><button class="btn btn-light btn-sm" data-edit-customer="{$customer['id']}">Upraviť</button><button class="btn btn-link btn-sm text-secondary" data-archive-customer="{$customer['id']}">{$archived ? 'Obnoviť' : 'Archivovať'}</button></div></div></article>{/foreach}
<p id="customer-empty" class="text-secondary text-center p-5 mb-0" hidden>V tomto zozname nie sú žiadni zákazníci.</p></section>
{include '../customer-dialog.latte'}
{/block}
