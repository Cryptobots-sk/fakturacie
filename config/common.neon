application:
    mapping: App\Presentation\*\**Presenter
    catchExceptions: true
session:
    expiration: 14 days
    cookieSamesite: Strict
    savePath: %tempDir%/sessions
services:
    router: App\Infrastructure\RouterFactory::create()
    - App\Infrastructure\Database(%databasePath%)
    - App\Domain\CustomerService
    - App\Domain\SettingsService
    - App\Domain\QrService
    - App\Pdf\PdfService(tempDir: %tempDir%)
    - App\Domain\InvoiceService
    - App\Domain\SmtpSettingsService
    - App\Domain\InvoiceEmailService
    - App\Mail\InvoiceMessageFactory
    - App\Mail\SmtpTransport
    - App\Infrastructure\RequestGuard
